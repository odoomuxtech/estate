<odoo>
    <!-- Search View -->
    <record id="estate_property_search_view" model="ir.ui.view">
        <field name="name">estate.property.search</field>
        <field name="model">real.estate</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="price"/>
                <field name="bedrooms"/>
                <field name="bathrooms"/>
                <field name="living_area"/>
                <field name="property_type_id"/>
                <filter name="filter_price" string="High Price" domain="[('price', '>=', 100000)]"/>
                <separator/>
                <group>
                    <filter string="Property Type" name="group_by_property_type" context="{'group_by': 'property_type_id'}"/>
                    <filter string="Bedrooms" name="group_by_bedrooms" context="{'group_by': 'bedrooms'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Form View -->
    <record id="estate_property_form_view" model="ir.ui.view">
        <field name="name">estate.property.form</field>
        <field name="model">real.estate</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <h1>
                            <field name="name"/>
                        </h1>
                    </group>
                    <group>
                        <group>
                            <field name="price"/>
                            <field name="bedrooms"/>
                            <field name="bathrooms"/>
                            <field name="property_type_id"/>
                        </group>
                        <group>
                            <field name="living_area"/>
                            <field name="garden_area"/>
                            <field name="total_area"/>
                            <field name="best_price"/>
                            <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                        </group>
                    </group>
                    <separator/>
                    <notebook>
                        <page string="Sales">
                            <group>
                                <field name="buyer_id"/>
                                <field name="user_id"/>
                            </group>
                        </page>
                         <page string="Description">
                            <field name="description"/>
                        </page>
                        <page string="Offers">
                    <field name="offer_ids">
                        <list>
                            <field name="price"/>
                            <field name="partner_id"/>
                            <field name="status"/>
                            <field name="validity"/>
                            <field name="date_deadline" force_save="1"/>
                        </list>
                    </field>
                    </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- List View -->
    <record id="estate_property_list_view" model="ir.ui.view">
        <field name="name">estate.property.list</field>
        <field name="model">real.estate</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="price"/>
                <field name="bedrooms"/>
                <field name="bathrooms"/>
                <field name="living_area"/>
                <field name="total_area"/>
                <field name="best_price"/>
                <field name="property_type_id"/>
                <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
            </list>
        </field>
    </record>

    <record id="test_record" model="ir.actions.act_window">
        <field name="name">Real Estate</field>
        <field name="res_model">real.estate</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
