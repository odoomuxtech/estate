<odoo>
    <!-- Search View -->
    <record id="estate_property_search_view" model="ir.ui.view">
        <field name="name">estate.property.search</field>
        <field name="model">real.estate</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="price"/>
                <field name="bedrooms"/>
                <field name="bathrooms"/>
                <field name="area"/>
                <field name="property_type"/>
                <filter name="filter_price" string="Price" domain="[('price', '>=', 100000)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_by_area" string="Area" context="{'group_by': 'area'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Form View -->
    <record id="estate_property_form_view" model="ir.ui.view">
        <field name="name">estate.property.form</field>
        <field name="model">real.estate</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <h1>
                            <field name="name"/>
                        </h1>
                    </group>
                    <group>
                        <field name="price"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- List View -->
    <record id="estate_property_list_view" model="ir.ui.view">
        <field name="name">estate.property.list</field>
        <field name="model">real.estate</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="price"/>
                <field name="bedrooms"/>
                <field name="bathrooms"/>
                <field name="area"/>
                <field name="property_type"/>
            </list>
        </field>
    </record>

    <record id="test_record" model="ir.actions.act_window">
        <field name="name">Real Estate</field>
        <field name="res_model">real.estate</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
